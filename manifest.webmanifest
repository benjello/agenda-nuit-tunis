---
layout: null
permalink: /manifest.webmanifest
---
{
  "name": "{{ site.title }}",
  "short_name": "ToNight",
  "description": "{{ site.description }}",
  "lang": "fr",
  "start_url": "{{ '/' | relative_url }}",
  "scope": "{{ '/' | relative_url }}",
  "display": "standalone",
  "background_color": "#faf7f2",
  "theme_color": "#b5442f",
  "id": "{{ '/' | relative_url }}",
  "dir": "auto",
  "categories": ["entertainment", "lifestyle", "events"],
  "icons": [
    { "src": "{{ '/assets/icones/icone-192.png' | relative_url }}", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "{{ '/assets/icones/icone-512.png' | relative_url }}", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "{{ '/assets/icones/icone-maskable-192.png' | relative_url }}", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "{{ '/assets/icones/icone-maskable-512.png' | relative_url }}", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Ce week-end", "url": "{{ '/week-end/' | relative_url }}" },
    { "name": "Cette semaine", "url": "{{ '/semaine/' | relative_url }}" }
  ]
}
